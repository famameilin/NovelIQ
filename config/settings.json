{
  "models": {
    "annotation": {
      "timeout_s": 180,
      "temperature": 0.7,
      "top_p": 0.8,
      "thinking": true,
      "streaming": true,
      "structured_output": "json_object",
      "max_iterations": 20,
      "total_attempts": 3,
      "allow_future_context": true
    },
    "paragraph_embedding": {
      "timeout_s": 120,
      "embedding_dim": 1024,
      "batch_size": 4,
      "semantic_enabled": true,
      "top_k": 5
    },
    "diagnosis": {
      "timeout_s": 180,
      "temperature": 1.0,
      "top_p": 0.95,
      "thinking": true,
      "streaming": true,
      "structured_output": "json_object",
      "max_iterations": 30,
      "total_attempts": 3
    }
  },
  "logging": {
    "console_level": "INFO",
    "log_dir": "logs",
    "rotation": "10 MB",
    "retention": "7 days",
    "compression": "zip",
    "modules": {
      "src.api": {
        "file": "api.log",
        "level": "DEBUG"
      },
      "src.workflows": {
        "file": "workflow.log",
        "level": "INFO"
      },
      "src.models": {
        "file": "model.log",
        "level": "DEBUG"
      },
      "src.metrics": {
        "file": "metrics.log",
        "level": "INFO"
      },
      "src.storage": {
        "file": "storage.log",
        "level": "INFO"
      },
      "src.agents": {
        "file": "agents.log",
        "level": "DEBUG"
      }
    },
    "third_party_level": "WARNING",
    "json_parse_preview_chars": 200
  },
  "paths": {
    "upload_dir": "data/uploads",
    "results_dir": "outputs",
    "log_dir": "logs",
    "lexicons_dir": "data/lexicons"
  },
  "progress": {
    "preprocess": {
      "start": 0,
      "end": 10
    },
    "annotate": {
      "start": 10,
      "end": 80
    },
    "aggregate": {
      "start": 80,
      "end": 90
    },
    "topic_model": {
      "start": 90,
      "end": 95
    },
    "diagnose": {
      "start": 95,
      "end": 100
    }
  },
  "topic_model": {
    "num_topics": 25,
    "passes": 10,
    "iterations": 500,
    "num_topics_min": 3,
    "num_topics_max": 25,
    "num_topics_scaling_divisor": 30,
    "lda": {
      "alpha": "auto",
      "eta": "auto",
      "random_state": 42,
      "chunksize": 2000,
      "minimum_probability": 0.01,
      "no_below": 5,
      "no_above": 0.5
    }
  },
  "metrics": {
    "mtld_threshold": 0.72,
    "middle_collapse_min_chunks": 10,
    "small_sample_min_chapters": 10,
    "function_word_min_chars": 100000,
    "character_max_iter": 100
  }
}

{
  "models": {
    "annotation": {
      "timeout_s": 180,
      "top_p": 0.95,
      "thinking": true,
      "streaming": true,
      "structured_output": "json_object",
      "max_iterations": 15,
      "allow_future_context": true
    },
    "paragraph_embedding": {
      "timeout_s": 120,
      "batch_size": 4
    },
    "diagnosis": {
      "timeout_s": 180,
      "top_p": 0.95,
      "thinking": true,
      "streaming": true,
      "structured_output": "json_object",
      "max_iterations": 30
    }
  },
  "logging": {
    "modules": {
      "src.api": {
        "file": "api.log",
        "level": "DEBUG"
      },
      "src.workflows": {
        "file": "workflow.log",
        "level": "INFO"
      },
      "src.models": {
        "file": "model.log",
        "level": "DEBUG"
      },
      "src.metrics": {
        "file": "metrics.log",
        "level": "INFO"
      },
      "src.storage": {
        "file": "storage.log",
        "level": "INFO"
      },
      "src.agents": {
        "file": "agents.log",
        "level": "DEBUG"
      }
    }
  },
  "paths": {
    "upload_dir": "data/uploads",
    "results_dir": "outputs",
    "log_dir": "logs",
    "lexicons_dir": "data/lexicons"
  },
  "linguistic": {
    "word2vec": {
      "enabled": true
    }
  }
}

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY src ./src
COPY config ./config
COPY data ./data

RUN mkdir -p /app/data/uploads /app/logs /app/outputs /app/models/topic

EXPOSE 8000

CMD ["uv", "run", "python", "-m", "src.api.main", "--host", "0.0.0.0", "--port", "8000"]

# PostgreSQL 数据库配置
# DATABASE_URL 只保留协议、主机、端口和数据库名；
# 用户名和密码通过 DATABASE_USERNAME / DATABASE_PASSWORD 单独配置
DATABASE_URL=postgresql+psycopg://localhost:5432/novel_analysis
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password

# PostgreSQL 测试数据库配置（用于运行测试）
# 建议使用独立的测试数据库，避免污染开发数据。
# 若测试库账号密码与开发库相同，可不额外配置 TEST_DATABASE_USERNAME / TEST_DATABASE_PASSWORD
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/novel_analysis_test
# TEST_DATABASE_USERNAME=postgres
# TEST_DATABASE_PASSWORD=your_password

# ============================================
# 模型配置 - 敏感信息请勿提交到版本控制
# ============================================

# 标注模型（本地）
ANNOTATION_BASE_URL=http://127.0.0.1:8111/v1
ANNOTATION_MODEL=Qwen3.5-9B-Q6_K
ANNOTATION_API_KEY=sk-no-key-required
ANNOTATION_TIMEOUT_S=120

# 标注兜底模型（fallback）
ANNOTATION_FALLBACK_BASE_URL=https://your-api-endpoint/v1
ANNOTATION_FALLBACK_MODEL=your-model-name
ANNOTATION_FALLBACK_API_KEY=your-api-key-here
ANNOTATION_FALLBACK_TIMEOUT_S=180

# 增量消歧模型
INCREMENTAL_DISAMBIG_BASE_URL=https://your-api-endpoint/v1
INCREMENTAL_DISAMBIG_MODEL=your-model-name
INCREMENTAL_DISAMBIG_API_KEY=your-api-key-here
INCREMENTAL_DISAMBIG_TIMEOUT_S=180

# LLM mention extraction 模型（可选；配置后会优先替代规则 mention extraction）
MENTION_EXTRACTION_BASE_URL=https://your-api-endpoint/v1
MENTION_EXTRACTION_MODEL=your-model-name
MENTION_EXTRACTION_API_KEY=your-api-key-here
MENTION_EXTRACTION_TIMEOUT_S=180

# 语义分块嵌入模型（本地）
SEMANTIC_CHUNKING_BASE_URL=http://127.0.0.1:8081/v1
SEMANTIC_CHUNKING_MODEL=Qwen3-Embedding-0.6B
SEMANTIC_CHUNKING_API_KEY=sk-no-key-required
SEMANTIC_CHUNKING_TIMEOUT_S=120

# 全量消歧模型
FULL_DISAMBIG_BASE_URL=https://your-api-endpoint/v1
FULL_DISAMBIG_MODEL=your-model-name
FULL_DISAMBIG_API_KEY=your-api-key-here
FULL_DISAMBIG_TIMEOUT_S=180

# Level3 rerank 模型（可选；配置后会在 paragraph local evidence 之后接管最终精排）
LEVEL3_RERANK_BASE_URL=https://your-api-endpoint/v1
LEVEL3_RERANK_MODEL=your-model-name
LEVEL3_RERANK_API_KEY=your-api-key-here
LEVEL3_RERANK_TIMEOUT_S=180

# 诊断模型
DIAGNOSIS_BASE_URL=https://your-api-endpoint/v1
DIAGNOSIS_MODEL=your-model-name
DIAGNOSIS_API_KEY=your-api-key-here
DIAGNOSIS_TIMEOUT_S=180

# DeepSeek 测试用（可选）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-api-key-here

# 连接池与语句超时（可选覆盖，缺省值见注释；不设置即用默认值）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT=30000
# DB_ECHO=false
